{
  "name": "jandres-me",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "jandres.me", "custom_domain": true },
    { "pattern": "www.jandres.me", "custom_domain": true }
  ]
}
