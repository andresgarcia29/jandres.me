---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";
import Palette from "../components/Palette.astro";
import { meta, person } from "../content/site";

interface Props { title?: string; description?: string }
const { title = meta.title, description = meta.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const sha = (import.meta.env.PUBLIC_COMMIT_SHA ?? "local").slice(0, 7);
const builtAt = import.meta.env.PUBLIC_BUILT_AT ?? new Date().toISOString();
const nav = [["about", "Summary"], ["work", "Experience"], ["projects", "Projects"], ["activity", "Activity"], ["contact", "Contact"]];
---
<!doctype html>
<html lang="en" style="color-scheme: dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#08090a" />
    <script is:inline>
      try { const t = localStorage.getItem("theme"); if (t) document.documentElement.style.colorScheme = t; } catch {}
    </script>
  </head>
  <body>
    <div class="progress" aria-hidden="true"></div>
    <a class="sr-only" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="wrap" aria-label="Main">
        <a class="brand mono" href="/"><span class="dot" aria-hidden="true"></span><span>jandres<span class="tld">.me</span></span></a>
        <ul>
          {nav.map(([id, label]) => <li><a href={`/#${id}`} data-nav={id}>{label}</a></li>)}
        </ul>
        <div class="tools">
          <button class="icon-btn mono" type="button" data-open-palette aria-label="⌘K: open command palette"><kbd>⌘K</kbd></button>
          <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle color theme">
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          </button>
        </div>
      </nav>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="wrap mono">
        <span><span class="dot" aria-hidden="true"></span>&nbsp; © {new Date().getFullYear()} {person.name} · uptime since 2016</span>
        <span>
          Astro · Cloudflare edge · data refreshed every 6h ·
          build <a href={`https://github.com/andresgarcia29/jandres.me/commit/${sha}`}>{sha}</a>
          <span data-ts={builtAt}></span> ·
          <a href="https://github.com/andresgarcia29/jandres.me">source</a>
        </span>
      </div>
    </footer>

    <Palette />

    <script is:inline>
      const root = document.documentElement;
      const rtf = new Intl.RelativeTimeFormat("en", { numeric: "auto" });
      const units = [["year", 31536e3], ["month", 2592e3], ["day", 864e2], ["hour", 3600], ["minute", 60]];
      document.querySelectorAll("[data-ts]").forEach((el) => {
        const s = (new Date(el.dataset.ts) - Date.now()) / 1000;
        const [unit, size] = units.find(([, n]) => Math.abs(s) >= n) ?? ["minute", 60];
        el.textContent = rtf.format(Math.round(s / size), unit);
        el.title = new Date(el.dataset.ts).toUTCString();
      });

      document.querySelector("[data-theme-toggle]")?.addEventListener("click", (e) => {
        const next = root.style.colorScheme === "light" ? "dark" : "light";
        const apply = () => { root.style.colorScheme = next; try { localStorage.setItem("theme", next); } catch {} };
        if (!document.startViewTransition || matchMedia("(prefers-reduced-motion: reduce)").matches) return apply();
        const { clientX: x, clientY: y } = e;
        const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
        document.startViewTransition(apply).ready.then(() =>
          root.animate({ clipPath: [`circle(0 at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`] },
            { duration: 550, easing: "cubic-bezier(.2,.7,.2,1)", pseudoElement: "::view-transition-new(root)" }));
      });

      document.addEventListener("pointermove", (e) => {
        const card = e.target instanceof Element && e.target.closest(".card");
        if (!card) return;
        const b = card.getBoundingClientRect();
        card.style.setProperty("--mx", `${e.clientX - b.left}px`);
        card.style.setProperty("--my", `${e.clientY - b.top}px`);
      }, { passive: true });

      const links = new Map([...document.querySelectorAll("[data-nav]")].map((a) => [a.dataset.nav, a]));
      const io = new IntersectionObserver((entries) => entries.forEach((en) => {
        if (en.isIntersecting) links.forEach((a, id) => a.toggleAttribute("aria-current", id === en.target.id));
      }), { rootMargin: "-45% 0px -50% 0px" });
      links.forEach((_, id) => { const s = document.getElementById(id); if (s) io.observe(s); });
    </script>
  </body>
</html>

<style>
  .site-header { position: sticky; top: 12px; z-index: 20; margin-top: 12px; }
  nav {
    display: flex; align-items: center; gap: 28px; height: 56px;
    max-width: calc(var(--max) - 48px); padding-inline: 12px 8px;
    background: color-mix(in srgb, var(--surface) 72%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    border: 1px solid var(--border); border-radius: 14px;
    box-shadow: var(--shadow);
  }
  .brand { display: flex; align-items: center; gap: 10px; padding-left: 10px; color: var(--text); text-decoration: none; font-size: 14px; font-weight: 600; }
  .tld { color: var(--muted); }
  nav ul { display: flex; gap: 4px; list-style: none; margin: 0 auto 0 0; padding: 0; }
  nav ul a { display: block; padding: 6px 12px; border-radius: 8px; color: var(--muted); text-decoration: none; font-size: 14px; transition: color .2s, background .2s; }
  nav ul a:hover { color: var(--text); }
  nav ul a[aria-current] { color: var(--text); background: color-mix(in srgb, var(--text) 7%, transparent); }
  .tools { display: flex; gap: 6px; }
  .icon-btn {
    display: inline-flex; align-items: center; justify-content: center; min-width: 38px; height: 38px; padding: 0 10px;
    border: 1px solid var(--border); border-radius: 8px; background: transparent; color: var(--muted); cursor: pointer;
    transition: color .2s, border-color .2s;
  }
  .icon-btn:hover { color: var(--text); border-color: var(--brand); }
  .icon-btn kbd { font-size: 11px; }
  .icon-btn svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .moon { display: none; }
  :global(html[style*="light"]) .sun { display: none; }
  :global(html[style*="light"]) .moon { display: block; }
  @media (max-width: 720px) { nav ul { display: none; } nav { justify-content: space-between; margin-inline: 12px; } }
  .site-footer { border-top: 1px solid var(--border); padding: 28px 0; font-size: 11px; color: var(--muted); }
  .site-footer .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; }
  .site-footer a { color: var(--muted); }
</style>
