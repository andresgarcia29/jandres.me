---
import Base from "../layouts/Base.astro";
import Heatmap from "../components/Heatmap.astro";
import { person, hero, slis, cases, experience, projects, principles, stack } from "../content/site";
import gh from "../data/github.json";

const builtAt = import.meta.env.PUBLIC_BUILT_AT ?? new Date().toISOString();
const repo = (name: string) => gh.repos.find((r) => r.name === name);
const shipped = [...gh.repos]
  .map((r) => {
    const useTag = r.tag && r.tagDate && (!r.shaDate || r.tagDate >= r.shaDate.slice(0, 10));
    return { name: r.name, label: useTag ? r.tag! : r.sha!, date: useTag ? r.tagDate! : r.shaDate!, url: useTag ? r.tagUrl! : r.shaUrl! };
  })
  .filter((r) => r.date)
  .sort((a, b) => b.date.localeCompare(a.date));

const terminal: [string, string, string?][] = [
  ["Name:", person.name],
  ["Role:", person.role],
  ["Location:", `${person.location} · remote`],
  ["Experience:", `${person.experience} · AWS · GCP · Kubernetes · Terraform`],
  ["Status:", person.status, "ok"],
];
---
<Base>
  <section class="hero wrap">
    <div class="term" role="img" aria-label={`kubectl describe engineer andres: ${person.name}, ${person.role}, ${person.location}, ${person.status}`}>
      <div class="term-bar"><i></i><i></i><i></i><span class="mono">andres@jandres.me: ~</span></div>
      <div class="term-body mono" aria-hidden="true">
        <p class="line" style="--i:0"><span class="prompt">$</span> <span class="cmdline">kubectl describe engineer andres</span></p>
        {terminal.map(([k, v, tone], i) => (
          <p class="line kv" style={`--i:${i + 1}`}>
            <span class="k">{k}</span>
            {tone === "ok" ? <span class="ok"><span class="dot"></span> {v}</span> : <span>{v}</span>}
          </p>
        ))}
        <p class="line kv" style={`--i:${terminal.length + 1}`}>
          <span class="k">Last deploy:</span>
          <span class="muted"><span data-ts={builtAt}></span> · data refreshed <span data-ts={gh.generatedAt}></span></span>
        </p>
        <p class="line" style={`--i:${terminal.length + 2}`}><span class="prompt">$</span> <span class="caret"></span></p>
      </div>
    </div>
    <h1>{hero}</h1>
    <p class="lead">
      Senior SRE / Platform Engineer. I've run live sports for 20–30M concurrent viewers, kept a regulated
      banking core at 99.99%, and built cloud platforms from zero. Looking for my next remote team.
    </p>
    <div class="ctas">
      <a class="btn primary" href={`mailto:${person.email}`}>Email me</a>
      <a class="btn" href={person.cv} download>Download CV</a>
      <a class="btn" href={person.github}>GitHub</a>
      <a class="btn" href={person.linkedin}>LinkedIn</a>
      <button class="btn hint mono" type="button" data-open-palette>Press ⌘K</button>
    </div>
  </section>

  <section id="status" class="wrap reveal">
    <h2>status</h2>
    <div class="status card">
      <p class="status-head"><span class="dot"></span> <strong>All systems operational</strong></p>
      <table>
        <thead><tr><th scope="col">Component</th><th scope="col">SLI</th><th scope="col">Status</th></tr></thead>
        <tbody>
          {slis.map((s) => (
            <tr>
              <th scope="row"><a href={`#${s.id}`}>{s.component}</a></th>
              <td>{s.sli}</td>
              <td class="ok mono"><span class="dot"></span>&nbsp;Operational</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section id="work" class="wrap">
    <h2>incident reviews</h2>
    <p class="lead">The work, written the way I'd write a postmortem: context, what I built, what happened.</p>
    <div class="cases">
      {cases.map((c) => (
        <article id={c.id} class="case card reveal">
          <header>
            <h3>{c.title}</h3>
            <span class="chip">{c.org}</span>
          </header>
          <dl>
            <dt>Context</dt><dd>{c.context}</dd>
            <dt>What I built</dt><dd>{c.built}</dd>
            <dt>Result</dt><dd>{c.result}</dd>
          </dl>
          <div class="chips">{c.stack.map((s) => <span class="chip">{s}</span>)}</div>
        </article>
      ))}
    </div>
    <ol class="timeline mono reveal" aria-label="Experience">
      {experience.map((e) => (
        <li>
          <span class="when">{e.period}</span>
          <span><strong>{e.role}</strong> · {e.org}{e.note && <span class="muted"> — {e.note}</span>}</span>
        </li>
      ))}
    </ol>
  </section>

  <section id="live" class="wrap reveal">
    <h2>live</h2>
    <div class="grid-2">
      <div class="card">
        <h3 class="mono">Contributions · last 12 months</h3>
        <Heatmap weeks={gh.weeks} total={gh.total} />
        <p class="muted mono small">{gh.total.toLocaleString("en-US")} contributions, public and private</p>
      </div>
      <div class="card">
        <h3 class="mono">Recently shipped</h3>
        <ul class="shipped mono">
          {shipped.map((s) => (
            <li>
              <a href={`https://github.com/andresgarcia29/${s.name}`}>{s.name}</a>
              <a class="tag" href={s.url}>{s.label}</a>
              <span class="muted" data-ts={s.date}></span>
            </li>
          ))}
        </ul>
        <p class="muted mono small">Refreshed every 6h by GitHub Actions · updated <span data-ts={gh.generatedAt}></span></p>
      </div>
    </div>
  </section>

  <section id="projects" class="wrap">
    <h2>projects</h2>
    <div class="grid-2">
      {projects.map((p) => {
        const r = repo(p.repo);
        return (
          <article class="project card reveal">
            <header>
              <h3><a href={`https://github.com/andresgarcia29/${p.repo}`}>{p.repo}</a></h3>
              <span class="chips">
                {r?.tag && <span class="chip">{r.tag}</span>}
                {r?.language && <span class="chip">{r.language}</span>}
              </span>
            </header>
            <p>{p.pitch}</p>
            {r && <p class="muted mono small">{r.commits.toLocaleString("en-US")} commits{r.releases ? ` · ${r.releases} releases` : ""}</p>}
            {p.install && (
              <div class="install mono">
                <code>{p.install}</code>
                <button class="copy" type="button" data-copy={p.install} aria-label="Copy install command">copy</button>
              </div>
            )}
            {p.media && (p.media.poster ? (
              <picture>
                <source srcset={p.media.poster} media="(prefers-reduced-motion: reduce)" />
                <img src={p.media.src} alt={p.media.alt} width={p.media.width} height={p.media.height} loading="lazy" decoding="async" />
              </picture>
            ) : (
              <img src={p.media.src} alt={p.media.alt} width={p.media.width} height={p.media.height} loading="lazy" decoding="async" />
            ))}
          </article>
        );
      })}
    </div>
  </section>

  <section id="runbook" class="wrap reveal">
    <h2>runbook</h2>
    <p class="lead">How I work, in the order I'd follow it during an incident.</p>
    <ol class="runbook">
      {principles.map(([title, body]) => <li><strong>{title}</strong> <span class="muted">{body}</span></li>)}
    </ol>
  </section>

  <section id="stack" class="wrap reveal">
    <h2>stack</h2>
    <div class="stack">
      {Object.entries(stack).map(([group, items]) => (
        <div>
          <h3 class="mono">{group}</h3>
          <div class="chips">{items.map((i) => <span class="chip">{i}</span>)}</div>
        </div>
      ))}
    </div>
  </section>

  <section id="contact" class="wrap reveal">
    <h2>contact</h2>
    <div class="card contact">
      <p class="big">Open to remote Senior SRE / Platform Engineering roles, full-time or contract.</p>
      <p class="muted">Guadalajara, Mexico (UTC-6), full overlap with the US working day. Email is fastest.</p>
      <div class="ctas">
        <a class="btn primary" href={`mailto:${person.email}`}>{person.email}</a>
        <button class="btn" type="button" data-copy={person.email}>Copy email</button>
        <a class="btn" href={person.cv} download>Download CV</a>
        <a class="btn" href={person.linkedin}>LinkedIn</a>
      </div>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((b) =>
    b.addEventListener("click", async () => {
      await navigator.clipboard?.writeText(b.dataset.copy!);
      const label = b.textContent;
      b.textContent = "copied ✓";
      setTimeout(() => (b.textContent = label), 1500);
    }),
  );
</script>

<style>
  .hero { padding-top: 48px; }
  .term { border: 1px solid var(--border); border-radius: 12px; background: light-dark(#ffffff, #0d1117); overflow: hidden; margin-bottom: 40px; }
  .term-bar { display: flex; align-items: center; gap: 8px; padding: 12px 16px; background: var(--surface); border-bottom: 1px solid var(--border); }
  .term-bar i { width: 12px; height: 12px; border-radius: 50%; background: #ff5f57; }
  .term-bar i:nth-child(2) { background: #febc2e; }
  .term-bar i:nth-child(3) { background: #28c840; }
  .term-bar span { margin: 0 auto; font-size: 13px; color: var(--muted); transform: translateX(-26px); }
  .term-body { padding: 20px 24px; font-size: clamp(13px, 1.9vw, 16px); overflow-x: auto; }
  .line { margin: 0 0 6px; white-space: pre-wrap; animation: appear .3s ease both; animation-delay: calc(var(--i) * 140ms + 150ms); }
  @keyframes appear { from { opacity: 0; transform: translateY(2px); } }
  .kv { display: grid; grid-template-columns: 14ch 1fr; gap: 8px; }
  .k { color: var(--muted); }
  .prompt { color: var(--violet); font-weight: 700; }
  .cmdline { color: var(--accent); }
  .ok { color: var(--ok); font-weight: 600; display: inline-flex; align-items: center; gap: 8px; }
  .caret { display: inline-block; width: 9px; height: 1.1em; vertical-align: text-bottom; background: var(--text); animation: blink 1.1s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (max-width: 560px) { .kv { grid-template-columns: 1fr; gap: 0; } .kv .k { font-size: 12px; } }

  .ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  .hint { color: var(--muted); }
  @media (hover: none) { .hint { display: none; } }

  .status { padding: 0; overflow-x: auto; }
  .status-head { display: flex; align-items: center; gap: 10px; margin: 0; padding: 16px 20px; border-bottom: 1px solid var(--border); color: var(--ok); }
  table { width: 100%; border-collapse: collapse; font-size: 15px; }
  th, td { text-align: left; padding: 12px 20px; border-bottom: 1px solid var(--border); vertical-align: top; }
  thead th { font: 600 12px var(--font-mono); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  tbody tr:last-child > * { border-bottom: 0; }
  tbody th { font-weight: 600; white-space: nowrap; }
  tbody th a { color: var(--text); text-decoration-color: var(--border); }
  td.ok { white-space: nowrap; font-size: 13px; }
  @media (max-width: 640px) {
    thead { display: none; }
    tr { display: grid; padding: 12px 16px; border-bottom: 1px solid var(--border); }
    th, td { padding: 2px 0; border: 0; white-space: normal !important; }
  }

  .cases { display: grid; gap: 16px; }
  .case header { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 8px 16px; margin-bottom: 12px; }
  .case h3 { margin: 0; }
  dl { display: grid; grid-template-columns: 120px 1fr; gap: 6px 20px; margin: 0 0 16px; }
  dt { font: 600 12px/2 var(--font-mono); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  dd { margin: 0; }
  @media (max-width: 640px) { dl { grid-template-columns: 1fr; } dd { margin-bottom: 8px; } }

  .timeline { list-style: none; padding: 0; margin: 24px 0 0; font-size: 14px; border-left: 2px solid var(--border); }
  .timeline li { position: relative; display: grid; grid-template-columns: 130px 1fr; gap: 12px; padding: 8px 0 8px 20px; }
  .timeline li::before { content: ""; position: absolute; left: -6px; top: 15px; width: 10px; height: 10px; border-radius: 50%; background: var(--bg); border: 2px solid var(--ok); }
  .when { color: var(--muted); }
  @media (max-width: 560px) { .timeline li { grid-template-columns: 1fr; gap: 0; } }

  .small { font-size: 12px; margin: 12px 0 0; }
  .shipped { list-style: none; padding: 0; margin: 0; font-size: 14px; }
  .shipped li { display: grid; grid-template-columns: 1fr auto auto; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--border); }
  .shipped li:last-child { border-bottom: 0; }
  .shipped a { color: var(--text); }
  .shipped .tag { color: var(--accent); text-decoration: none; }

  .project header { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .project h3 { margin: 0 0 8px; }
  .project h3 a { color: var(--text); }
  .project img { margin-top: 16px; border-radius: 6px; border: 1px solid var(--border); width: 100%; }
  .install { display: flex; align-items: center; gap: 8px; background: var(--bg); border: 1px solid var(--border); border-radius: 6px; padding: 8px 10px; font-size: 13px; }
  .install code { flex: 1; min-width: 0; white-space: nowrap; overflow-x: auto; scrollbar-width: none; }
  .copy { flex: none; font: 12px var(--font-mono); background: none; border: 1px solid var(--border); border-radius: 4px; color: var(--muted); cursor: pointer; padding: 2px 8px; }

  .runbook { counter-reset: step; list-style: none; padding: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); }
  .runbook li { counter-increment: step; display: flex; flex-wrap: wrap; gap: 4px 8px; padding: 16px 16px 16px 56px; position: relative; border: 1px solid var(--border); border-radius: var(--radius); }
  .runbook li::before { content: counter(step, decimal-leading-zero); position: absolute; left: 16px; top: 16px; font: 700 14px var(--font-mono); color: var(--violet); }

  .stack { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .stack h3 { font-size: 14px; color: var(--muted); margin-bottom: 8px; }

  .contact .big { font-size: 20px; font-weight: 600; }
</style>
