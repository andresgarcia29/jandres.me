---
import Base from "../layouts/Base.astro";
import Heatmap from "../components/Heatmap.astro";
import Trace from "../components/Trace.astro";
import { person, summary, highlights, trace, projects, stack, languages, education, selectedWork, principles } from "../content/site";
import gh from "../data/github.json";

const fmt = (n: number) => n.toLocaleString("en-US");
const repo = (name: string) => gh.repos.find((r) => r.name === name);
const month = (s: string) => { const [y, m] = s.split("-").map(Number); return y * 12 + (m - 1); };
const now = new Date();
const nowM = now.getFullYear() * 12 + now.getMonth();
const dur = (a: string, b: string | null) => {
  const n = (b ? month(b) : nowM) - month(a);
  const y = Math.floor(n / 12), m = n % 12;
  return [y && `${y} yr${y > 1 ? "s" : ""}`, m && `${m} mo`].filter(Boolean).join(" ") || "< 1 mo";
};
const date = (s: string) => new Date(`${s}-01T00:00:00Z`).toLocaleString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });
const roles = trace.filter((s) => s.kind !== "early");
const early = trace.filter((s) => s.kind === "early");
const shipped = [...gh.repos]
  .map((r) => {
    const useTag = r.tag && r.tagDate && (!r.shaDate || r.tagDate >= r.shaDate.slice(0, 10));
    return { name: r.name, label: useTag ? r.tag! : r.sha!, date: useTag ? r.tagDate! : r.shaDate!, url: useTag ? r.tagUrl! : r.shaUrl!, kind: useTag ? "release" : "commit" };
  })
  .filter((r) => r.date)
  .sort((a, b) => b.date.localeCompare(a.date));
---
<Base>
  <div class="resume wrap">
    <aside class="side">
      <div class="id card">
        <p class="cmd mono"><span class="prompt">$</span> <span class="typed" style="--n:32">kubectl describe engineer andres</span></p>
        <h1>{person.name}</h1>
        <p class="role">{person.role}</p>
        <p class="status mono"><span class="dot"></span> Available for remote roles</p>
        <dl class="facts mono">
          <dt>location</dt><dd>Guadalajara, Mexico</dd>
          <dt>timezone</dt><dd>UTC-6 · overlaps US hours</dd>
          <dt>experience</dt><dd>{person.experience}</dd>
          <dt>open to</dt><dd>full-time · contract</dd>
        </dl>
        <div class="actions">
          <a class="btn primary" href={`mailto:${person.email}`}>Email me <span class="arrow">→</span></a>
          <a class="btn" href={person.cv} download>CV · PDF</a>
        </div>
        <ul class="links mono">
          <li><a href={`mailto:${person.email}`}>{person.email}</a> <button class="copy" type="button" data-copy={person.email} aria-label="Copy email">copy</button></li>
          <li><a href={person.linkedin}>linkedin.com/in/andres-garcia-sre</a></li>
          <li><a href={person.github}>github.com/andresgarcia29</a></li>
        </ul>
      </div>

      <div class="card side-block">
        <h2 class="label">Skills</h2>
        {Object.entries(stack).map(([group, items]) => (
          <div class="skill-group">
            <h3>{group}</h3>
            <div class="chips">{items.map((i) => <span class="chip">{i}</span>)}</div>
          </div>
        ))}
      </div>

      <div class="card side-block">
        <h2 class="label">Languages</h2>
        <dl class="kv">{languages.map(([l, lvl]) => <><dt>{l}</dt><dd>{lvl}</dd></>)}</dl>
        <h2 class="label">Education</h2>
        <ul class="edu">{education.map(([what, where]) => <li><strong>{what}</strong><span>{where}</span></li>)}</ul>
      </div>
    </aside>

    <div class="main">
      <section id="about" class="block">
        <h2 class="label">Summary</h2>
        <p class="summary">{summary}</p>
        <div class="highlights">
          {highlights.map(([n, l]) => <div><span class="num mono">{n}</span><span class="muted">{l}</span></div>)}
        </div>
      </section>

      <section id="work" class="block">
        <h2 class="label">Experience</h2>
        <Trace />

        <ol class="jobs">
          {roles.map((r) => (
            <li id={`exp-${r.id}`} class={`job ${r.kind}`}>
              <header>
                <div>
                  <h3>{r.role}</h3>
                  <p class="org">{r.org}{r.place && <span class="muted"> · {r.place}</span>}</p>
                </div>
                <p class="when mono">
                  {date(r.start)} — {r.end ? date(r.end) : <span class="now"><span class="dot"></span> present</span>}
                  <span class="muted">{dur(r.start, r.end)}</span>
                </p>
              </header>
              {r.events && <ul class="bullets">{r.events.map((e) => <li>{e}</li>)}</ul>}
              {r.attrs && <div class="chips">{r.attrs.map((a) => <span class="chip">{a}</span>)}</div>}
            </li>
          ))}
        </ol>

        <div class="early">
          <h3 class="mono">Earlier · 2016 – 2018</h3>
          <ul>
            {early.map((r) => (
              <li><strong>{r.role}</strong> · {r.org} <span class="muted mono">{date(r.start)} — {date(r.end!)}</span></li>
            ))}
          </ul>
        </div>
      </section>

      <section id="projects" class="block">
        <h2 class="label">Selected work &amp; open source</h2>
        {selectedWork.map((w) => (
          <div class="card work-item">
            <h3>{w.title}</h3>
            <p class="muted">{w.body}</p>
          </div>
        ))}
        <div class="bento">
          {projects.map((p) => {
            const r = repo(p.repo);
            return (
              <article class="project card">
                <header>
                  <h3><a href={`https://github.com/andresgarcia29/${p.repo}`}>{p.repo} <span class="arrow">↗</span></a></h3>
                  <span class="chips">
                    {r?.tag && <span class="chip ok-chip">{r.tag}</span>}
                    {r?.language && <span class="chip">{r.language}</span>}
                  </span>
                </header>
                <p>{p.pitch}</p>
                {r && (
                  <p class="stats mono">
                    <span><b>{fmt(r.commits)}</b> commits</span>
                    {r.releases > 0 && <span><b>{r.releases}</b> releases</span>}
                    {r.shaDate && <span>last push <b data-ts={r.shaDate}></b></span>}
                  </p>
                )}
                {p.install && (
                  <div class="install mono">
                    <span class="prompt">$</span>
                    <code>{p.install}</code>
                    <button class="copy" type="button" data-copy={p.install} aria-label="Copy install command">copy</button>
                  </div>
                )}
                {p.media && (
                  <div class="shot">
                    {p.media.poster ? (
                      <picture>
                        <source srcset={p.media.poster} media="(prefers-reduced-motion: reduce)" />
                        <img src={p.media.src} alt={p.media.alt} width={p.media.width} height={p.media.height} loading="lazy" decoding="async" />
                      </picture>
                    ) : (
                      <img src={p.media.src} alt={p.media.alt} width={p.media.width} height={p.media.height} loading="lazy" decoding="async" />
                    )}
                  </div>
                )}
              </article>
            );
          })}
        </div>
      </section>

      <section id="activity" class="block">
        <h2 class="label">Activity · live from GitHub</h2>
        <div class="card">
          <Heatmap weeks={gh.weeks} total={gh.total} />
          <p class="muted mono small">{fmt(gh.total)} contributions in the last 12 months, public and private</p>
        </div>
        <div class="card shipped-card">
          <ul class="shipped mono">
            {shipped.map((s) => (
              <li>
                <span class={`kind ${s.kind}`}>{s.kind}</span>
                <a href={`https://github.com/andresgarcia29/${s.name}`}>{s.name}</a>
                <a class="tag" href={s.url}>{s.label}</a>
                <span class="muted" data-ts={s.date}></span>
              </li>
            ))}
          </ul>
          <p class="muted mono small">Refreshed every 6h by a scheduled workflow · updated <span data-ts={gh.generatedAt}></span></p>
        </div>
      </section>

      <section id="principles" class="block">
        <h2 class="label">How I work</h2>
        <ol class="principles">
          {principles.map(([t, b]) => <li><strong>{t}</strong> <span class="muted">{b}</span></li>)}
        </ol>
      </section>

      <section id="contact" class="block">
        <div class="card contact">
          <h2>Let's talk.</h2>
          <p class="muted">Open to remote Senior SRE / Platform Engineering roles, full-time or contract. Email is fastest.</p>
          <div class="actions">
            <a class="btn primary" href={`mailto:${person.email}`}>{person.email} <span class="arrow">→</span></a>
            <a class="btn" href={person.cv} download>Download CV</a>
            <a class="btn" href={person.linkedin}>LinkedIn</a>
          </div>
        </div>
      </section>
    </div>
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((b) =>
    b.addEventListener("click", async () => {
      await navigator.clipboard?.writeText(b.dataset.copy!);
      const label = b.textContent;
      b.textContent = "copied ✓";
      setTimeout(() => (b.textContent = label), 1500);
    }),
  );
</script>

<style>
  .resume { display: grid; grid-template-columns: 340px 1fr; gap: 40px; padding-top: 40px; padding-bottom: 96px; align-items: start; }
  .side { position: sticky; top: 88px; display: grid; gap: 16px; max-height: calc(100vh - 104px); overflow-y: auto; scrollbar-width: none; }
  .main { min-width: 0; display: grid; gap: 64px; }
  section.block { padding: 0; }
  @media (max-width: 960px) {
    .resume { grid-template-columns: 1fr; gap: 48px; }
    .side { position: static; max-height: none; overflow: visible; }
  }

  .label { font: 600 11px/1 var(--font-display); text-transform: uppercase; letter-spacing: .16em; color: var(--ok); margin: 0 0 18px; display: flex; align-items: center; gap: 12px; }
  .label::after { content: ""; flex: 1; height: 1px; background: var(--border); }

  /* Identity card */
  .id { padding: 24px; }
  .cmd { font-size: 11px; margin: 0 0 18px; white-space: nowrap; overflow: hidden; color: var(--muted); }
  .prompt { color: var(--violet); font-weight: 700; }
  .typed { display: inline-block; vertical-align: bottom; overflow: hidden; white-space: nowrap; color: var(--accent);
    width: calc(var(--n) * 1ch); animation: type 1.3s steps(var(--n)) .3s both; }
  @keyframes type { from { width: 0; } }
  h1 { font: 600 34px/1.05 var(--font-sans); letter-spacing: -0.03em; margin: 0 0 6px; }
  .role { font: 400 20px/1.2 var(--font-serif); font-style: italic; color: var(--ok); margin: 0 0 16px; }
  .status { display: inline-flex; align-items: center; gap: 10px; font-size: 11.5px; padding: 6px 12px; border-radius: 999px; margin: 0 0 18px;
    color: var(--ok); background: var(--ok-dim); border: 1px solid color-mix(in srgb, var(--ok) 30%, transparent); }
  .facts { display: grid; grid-template-columns: 92px 1fr; gap: 6px 10px; font-size: 12px; margin: 0 0 20px; }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
  .links { list-style: none; padding: 16px 0 0; margin: 0; border-top: 1px solid var(--border); display: grid; gap: 8px; font-size: 11.5px; }
  .links a { color: var(--text); text-decoration: none; }
  .links a:hover { color: var(--ok); }
  .copy { font: 10px var(--font-display); background: none; border: 1px solid var(--border); border-radius: 6px; color: var(--muted); cursor: pointer; padding: 2px 6px; margin-left: 6px; }
  .copy:hover { color: var(--ok); border-color: var(--ok); }

  .side-block { padding: 22px 24px; }
  .side-block .label { margin-bottom: 14px; }
  .side-block .label:not(:first-child) { margin-top: 22px; }
  .skill-group + .skill-group { margin-top: 14px; }
  .skill-group h3 { font: 500 11px var(--font-sans); color: var(--muted); margin: 0 0 8px; }
  .kv { display: grid; grid-template-columns: auto 1fr; gap: 6px 16px; margin: 0; font-size: 14px; }
  .kv dt { font-weight: 600; }
  .kv dd { margin: 0; color: var(--muted); }
  .edu { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; font-size: 14px; }
  .edu li { display: flex; flex-direction: column; }
  .edu span { color: var(--muted); font-size: 13px; }

  /* Summary */
  .summary { font-size: clamp(17px, 1.6vw, 20px); line-height: 1.6; max-width: 68ch; }
  .highlights { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin-top: 28px; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
  .highlights > div { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px; background: color-mix(in srgb, var(--surface) 70%, transparent); }
  .highlights > div + div { border-left: 1px solid var(--border); }
  .num { font-size: clamp(24px, 2.6vw, 32px); font-weight: 700; letter-spacing: -0.04em; color: var(--ok); line-height: 1; }
  .highlights .muted { font-size: 13px; }
  @media (max-width: 560px) { .highlights { grid-template-columns: 1fr; } .highlights > div + div { border-left: 0; border-top: 1px solid var(--border); } }

  /* Jobs */
  .jobs { list-style: none; padding: 0 0 0 28px; margin: 40px 0 0; position: relative; display: grid; gap: 40px; }
  .jobs::before { content: ""; position: absolute; left: 6px; top: 8px; bottom: 8px; width: 1px; background: linear-gradient(var(--ok), var(--border) 30%, var(--border)); }
  .job { position: relative; scroll-margin-top: 96px; }
  .job::before { content: ""; position: absolute; left: -27px; top: 8px; width: 11px; height: 11px; border-radius: 50%; background: var(--bg); border: 2px solid var(--ok); }
  .job.oss::before { border-color: var(--violet); }
  .job:first-child::before { background: var(--ok); box-shadow: 0 0 0 5px var(--ok-dim); }
  .job:target { animation: flash 1.6s var(--ease); }
  @keyframes flash { from { background: color-mix(in srgb, var(--ok) 12%, transparent); } }
  .job header { display: flex; justify-content: space-between; gap: 8px 24px; flex-wrap: wrap; margin-bottom: 12px; }
  .job h3 { font: 600 19px/1.3 var(--font-sans); letter-spacing: -0.01em; margin: 0; }
  .org { margin: 2px 0 0; font-weight: 500; color: var(--ok); }
  .job.oss .org { color: var(--violet); }
  .org .muted { font-weight: 400; }
  .when { margin: 0; font-size: 12px; text-align: right; display: flex; flex-direction: column; gap: 2px; }
  .now { color: var(--ok); display: inline-flex; align-items: center; gap: 6px; }
  .bullets { margin: 0 0 14px; padding-left: 18px; display: grid; gap: 6px; }
  .bullets li::marker { color: var(--ok); }
  @media (max-width: 560px) { .when { text-align: left; } }

  .early { margin-top: 40px; padding-top: 24px; border-top: 1px dashed var(--border); }
  .early h3 { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 12px; }
  .early ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; font-size: 14.5px; }
  .early .muted { font-size: 11.5px; }

  /* Projects */
  .work-item { margin-bottom: 16px; }
  .work-item h3 { font-size: 16px; margin-bottom: 6px; }
  .work-item p { margin: 0; }
  .bento { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 720px) { .bento { grid-template-columns: 1fr; } }
  .project { display: flex; flex-direction: column; padding: 24px; }
  .project header { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .project h3 { font-size: 16px; margin: 0 0 8px; }
  .project h3 a { color: var(--text); text-decoration: none; }
  .project h3 .arrow { color: var(--muted); display: inline-block; transition: transform .2s var(--ease); }
  .project:hover h3 .arrow { transform: translate(2px, -2px); color: var(--ok); }
  .project p { font-size: 14.5px; }
  .ok-chip { color: var(--ok); border-color: color-mix(in srgb, var(--ok) 40%, transparent); }
  .stats { display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 11px; color: var(--muted); margin: 0 0 14px; }
  .stats b { color: var(--text); font-weight: 600; }
  .install { display: flex; align-items: center; gap: 10px; background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 9px 12px; font-size: 11.5px; }
  .install code { flex: 1; min-width: 0; white-space: nowrap; overflow-x: auto; scrollbar-width: none; }
  .install .copy { margin: 0; flex: none; }
  .shot { margin-top: auto; padding-top: 18px; }
  .shot img { border-radius: 10px; border: 1px solid var(--border); width: 100%; transition: transform .5s var(--ease); }
  .project:hover .shot img { transform: translateY(-3px); }

  /* Activity */
  #activity .card + .card { margin-top: 16px; }
  .small { font-size: 11px; margin: 12px 0 0; }
  .shipped { list-style: none; padding: 0; margin: 0; font-size: 12.5px; }
  .shipped li { display: grid; grid-template-columns: 64px 1fr auto auto; gap: 12px; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--border); }
  .shipped li:last-child { border-bottom: 0; }
  .shipped a { color: var(--text); }
  .shipped .tag { color: var(--ok); text-decoration: none; }
  .kind { font-size: 9.5px; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); }
  .kind.release { color: var(--amber); }

  /* Principles */
  .principles { counter-reset: p; list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; grid-template-columns: 1fr 1fr; }
  .principles li { counter-increment: p; padding-left: 36px; position: relative; font-size: 14.5px; }
  .principles li::before { content: counter(p, decimal-leading-zero); position: absolute; left: 0; font: 700 12px/1.9 var(--font-display); color: var(--ok); }
  @media (max-width: 720px) { .principles { grid-template-columns: 1fr; } }

  /* Contact */
  .contact { padding: 36px; background: radial-gradient(500px 240px at 100% 0%, color-mix(in srgb, var(--ok) 14%, transparent), transparent 70%), color-mix(in srgb, var(--surface) 85%, transparent); }
  .contact h2 { font: 400 40px/1.1 var(--font-serif); font-style: italic; margin-bottom: 10px; }
</style>
