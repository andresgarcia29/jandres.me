---
import { trace } from "../content/site";

const month = (s: string) => { const [y, m] = s.split("-").map(Number); return y * 12 + (m - 1); };
const now = new Date();
const nowM = now.getFullYear() * 12 + now.getMonth();
const first = Math.min(...trace.map((s) => month(s.start)));
const startYear = Math.floor(first / 12);
const min = startYear * 12;
const max = nowM + 3;
const pct = (m: number) => ((m - min) / (max - min)) * 100;
const fmt = (months: number) => {
  const y = Math.floor(months / 12), m = months % 12;
  return [y && `${y}y`, m && `${m}m`].filter(Boolean).join(" ") || "<1m";
};
const label = (s: string) => new Date(`${s}-01T00:00:00Z`).toLocaleString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });
const years = Array.from({ length: Math.floor(max / 12) - startYear + 1 }, (_, i) => startYear + i).filter((y) => y * 12 < max);
const total = nowM - first;

const spans = trace.map((s, i) => {
  const a = month(s.start), b = s.end ? month(s.end) : nowM;
  return { ...s, i, left: pct(a), width: Math.max(pct(b) - pct(a), 0.8), dur: fmt(b - a), live: !s.end,
           range: `${label(s.start)} → ${s.end ? label(s.end) : "now"}` };
});
---
<div class="trace card">
  <div class="trace-head mono">
    <span><span class="k">trace_id</span> andres.career</span>
    <span><span class="k">spans</span> {spans.length}</span>
    <span><span class="k">duration</span> {fmt(total)}</span>
    <span><span class="k">status</span> <span class="ok">OK</span></span>
  </div>

  <div class="axis mono" aria-hidden="true">
    <span></span>
    <div class="ticks">
      {years.map((y) => <span style={`left:${pct(y * 12)}%`}>{y}</span>)}
    </div>
  </div>

  <ol class="spans">
    {spans.map((s) => (
      <li class={`span ${s.kind}`} style={`--left:${s.left}%; --width:${s.width}%; --i:${s.i}`}>
        <details>
          <summary>
            <span class="who">
              <span class="svc mono">{s.org}</span>
              <span class="op">{s.role}</span>
            </span>
            <span class="lane">
              <span class="bar" title={s.range}>
                {s.live && <span class="live mono"><span class="dot"></span> live</span>}
              </span>
              <span class="dur mono">{s.dur}</span>
            </span>
          </summary>
          <div class="detail">
            <p class="mono range">{s.range}{s.place && <> · {s.place}</>}</p>
            {s.events && (
              <ul class="events">
                {s.events.map((e) => <li><span class="mono ev">event</span> {e}</li>)}
              </ul>
            )}
            {s.attrs && <div class="chips">{s.attrs.map((a) => <span class="chip">{a}</span>)}</div>}
          </div>
        </details>
      </li>
    ))}
  </ol>
  <p class="hint mono">Click a span to expand its attributes and events.</p>
</div>

<style>
  .trace { padding: 0; overflow: hidden; }
  .trace-head { display: flex; flex-wrap: wrap; gap: 8px 28px; padding: 16px 24px; border-bottom: 1px solid var(--border); font-size: 12px; }
  .k { color: var(--muted); margin-right: 6px; }
  .ok { color: var(--ok); }
  .axis, summary { display: grid; grid-template-columns: minmax(200px, 30%) 1fr; gap: 20px; }
  .axis { padding: 14px 24px 6px; font-size: 11px; color: var(--muted); }
  .ticks { position: relative; height: 16px; }
  .ticks span { position: absolute; transform: translateX(-50%); }
  .ticks span::after { content: ""; position: absolute; left: 50%; top: 18px; height: 2000px; border-left: 1px dashed color-mix(in srgb, var(--border) 70%, transparent); pointer-events: none; }
  .spans { list-style: none; margin: 0; padding: 0 0 8px; position: relative; }
  .span { border-top: 1px solid color-mix(in srgb, var(--border) 50%, transparent); position: relative; }
  .span:first-child { border-top: 0; }
  summary { padding: 12px 24px; cursor: pointer; list-style: none; align-items: center; transition: background .2s; }
  summary::-webkit-details-marker { display: none; }
  summary:hover, details[open] summary { background: color-mix(in srgb, var(--ok) 6%, transparent); }
  .who { display: flex; flex-direction: column; min-width: 0; }
  .svc { font-size: 13px; font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .svc::before { content: "▸"; color: var(--muted); display: inline-block; margin-right: 8px; transition: transform .2s; }
  details[open] .svc::before { transform: rotate(90deg); }
  .op { font-size: 13px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lane { position: relative; height: 26px; }
  .bar {
    position: absolute; top: 4px; bottom: 4px; left: var(--left); width: var(--width); border-radius: 4px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--ok) 85%, transparent), var(--ok));
    box-shadow: 0 0 18px -6px var(--ok);
    transform-origin: left center;
  }
  .early .bar { background: color-mix(in srgb, var(--muted) 45%, transparent); box-shadow: none; }
  .oss .bar { background: linear-gradient(90deg, color-mix(in srgb, var(--violet) 70%, transparent), var(--violet)); box-shadow: 0 0 18px -6px var(--violet); }
  .bar:has(.live)::after {
    content: ""; position: absolute; inset: 0; border-radius: inherit;
    background: repeating-linear-gradient(110deg, transparent 0 12px, rgb(255 255 255 / .18) 12px 18px);
    background-size: 200% 100%; animation: flow 1.6s linear infinite;
  }
  @keyframes flow { to { background-position: -38px 0; } }
  .live { position: absolute; right: 6px; top: 50%; transform: translateY(-50%); z-index: 1; display: flex; align-items: center; gap: 6px;
    font-size: 10px; text-transform: uppercase; letter-spacing: .1em; color: light-dark(#fff, #04150a); font-weight: 700; }
  .live .dot { background: currentColor; }
  .dur { position: absolute; top: 50%; transform: translateY(-50%); left: calc(var(--left) + var(--width) + 8px); font-size: 11px; color: var(--muted); white-space: nowrap; }
  .span:has(.live) .dur { left: auto; right: calc(100% - var(--left) + 8px); }
  .detail { padding: 4px 24px 18px calc(min(30%, 9999px) + 44px); }
  .range { font-size: 12px; color: var(--muted); margin-bottom: 10px; }
  .events { list-style: none; padding: 0; margin: 0 0 12px; display: grid; gap: 6px; }
  .ev { font-size: 10px; text-transform: uppercase; letter-spacing: .12em; color: var(--amber); border: 1px solid color-mix(in srgb, var(--amber) 40%, transparent); border-radius: 4px; padding: 1px 6px; margin-right: 8px; }
  .hint { font-size: 11px; color: var(--muted); padding: 10px 24px 16px; margin: 0; border-top: 1px solid var(--border); }

  @supports (animation-timeline: view()) {
    .bar { animation: draw linear both; animation-timeline: view(); animation-range: entry 10% cover 30%; }
    @keyframes draw { from { transform: scaleX(0); opacity: .3; } }
  }

  @media (max-width: 720px) {
    .axis { grid-template-columns: 1fr; padding-inline: 16px; }
    .axis > span:first-child { display: none; }
    summary { grid-template-columns: 1fr; gap: 6px; padding: 12px 16px; }
    .detail { padding: 4px 16px 16px; }
    .trace-head { padding: 14px 16px; gap: 6px 18px; }
    .ticks span:nth-child(odd) { visibility: hidden; }
  }
</style>
