---
interface Day { d: string; c: number; l: number }
interface Props { weeks: Day[][]; total: number }
const { weeks, total } = Astro.props;
---
<div class="heatmap" role="img" aria-label={`${total.toLocaleString("en-US")} contributions in the last year`}>
  {weeks.map((week, w) => (
    <div class="week" style={`--w:${w}`}>
      {week.map((day) => <i data-l={day.l} title={`${day.c} contributions on ${day.d}`}></i>)}
    </div>
  ))}
</div>
<div class="legend mono" aria-hidden="true">
  less <i data-l="0"></i><i data-l="1"></i><i data-l="2"></i><i data-l="3"></i><i data-l="4"></i> more
</div>

<style>
  .heatmap { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 2px; margin: 8px 0 4px; }
  .week { display: grid; grid-template-rows: repeat(7, 1fr); gap: 2px; animation: fade .4s ease both; animation-delay: calc(var(--w) * 12ms); }
  i { display: block; aspect-ratio: 1; border-radius: 2px; background: var(--heat-0); }
  i[data-l="1"] { background: var(--heat-1); }
  i[data-l="2"] { background: var(--heat-2); }
  i[data-l="3"] { background: var(--heat-3); }
  i[data-l="4"] { background: var(--heat-4); }
  .heatmap i:hover { outline: 1px solid var(--text); }
  @keyframes fade { from { opacity: 0; } }
  .legend { display: flex; align-items: center; justify-content: flex-end; gap: 3px; font-size: 11px; color: var(--muted); }
  .legend i { width: 10px; }
</style>
